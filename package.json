{
  "name": "fekra-website",
  "version": "1.0.0",
  "private": true,
  "description": "FEKRA marketing website — Next.js App Router + Payload CMS, 5 locales, light/dark.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && pnpm dev",
    "build": "node scripts/migrate.mjs && cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env src/seed/index.ts",
    "seed:team": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-team.ts",
    "seed:services": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-services.ts",
    "seed:role-pages": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-role-pages.ts",
    "fix:content": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/fix-master-plan-content.ts",
    "fix:role-hero": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/fix-role-hero.ts",
    "seed:contact": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-contact.ts",
    "seed:jobs": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-jobs.ts",
    "check:i18n": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-i18n.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:locale": "node scripts/check-locale-page.mjs",
    "check:viewports": "node scripts/check-viewports.mjs",
    "perf": "node scripts/check-perf.mjs",
    "inventory": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/page-inventory.ts",
    "check:shared-sections": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-shared-sections.ts",
    "test:api": "newman run postman/FEKRA.postman_collection.json -e postman/FEKRA.local.postman_environment.json --working-dir postman",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "check:storage": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-storage.mjs",
    "sync:uploads": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/sync-uploads.mjs",
    "check:content-ar": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-arabic-content.ts"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "lenis": "^1.3.26",
    "lucide-react": "1.30.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "node-html-markdown": "2.0.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18",
      "fast-uri@<3.1.7": "^3.1.7",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "source-map-js@<1.2.2": "^1.2.2",
      "dompurify@<3.4.16": "^3.4.16",
      "fast-copy@>=3.0.0 <3.1.0": "^3.1.0"
    }
  }
}
