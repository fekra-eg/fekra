##
## FEKRA website — environment contract (checklist 3.5 / 3.6)
## Copy to .env.local for development. Never commit real values.
##

# ---- Core ---------------------------------------------------------------
# Public origin, no trailing slash. Drives canonical URLs, sitemap, OG, CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development — anything but "production" forces noindex.
NEXT_PUBLIC_ENV=development

# ---- Database -----------------------------------------------------------
# Postgres connection string (Neon/Supabase/RDS). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@localhost:5432/fekra

# ---- Payload ------------------------------------------------------------
# 32+ random chars. Rotating this invalidates every admin session.
PAYLOAD_SECRET=
# Shared secret for draft preview links (/api/preview).
PREVIEW_SECRET=

# ---- Seeding ------------------------------------------------------------
# `pnpm seed` is idempotent. Against a NON-local DATABASE_URL it refuses to run
# with the default password, so pass your own:
#   SEED_ADMIN_EMAIL=you@fekra-egy.com SEED_ADMIN_PASSWORD='...' pnpm seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# "false" skips the sample articles and example job — use it on a real database.
SEED_DEMO_CONTENT=true

# ---- Media & CV storage (Supabase Storage, S3-compatible) ---------------
# Uploads go to ONE bucket: media under media/, CVs under applications/.
# Leave S3_BUCKET empty to fall back to local disk — fine for development,
# but on Vercel local uploads are wiped on every deploy.
#
# Bucket: create `fekra_assets` in Supabase → Storage. Keep it PRIVATE; the
# app streams files through /cms-api, so nothing needs public read, and CV
# downloads are signed with a 5-minute expiry.
#
# Keys: Supabase → Storage → S3 Access Keys → "New access key". These are NOT
# the anon/service keys and are shown once.
S3_BUCKET=fekra_assets
# Must be the project's real region — `auto` works for R2 but breaks Supabase
# request signing with an opaque 403. Read it off the project's DATABASE_URL
# host, e.g. aws-0-eu-north-1.pooler.supabase.com -> eu-north-1.
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supabase S3 endpoint — same project ref as DATABASE_URL.
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# Only needed if you serve media straight off the bucket instead of through
# the app; it is added to next/image remotePatterns.
S3_PUBLIC_HOST=

# ---- Email (Resend) -----------------------------------------------------
# Without a key, form submissions still save but no notification is sent.
RESEND_API_KEY=
EMAIL_FROM=website@fekra-egy.com

# ---- Holding page -------------------------------------------------------
# "true" serves /coming-soon for every PUBLIC route. /admin, /cms-api and /api
# keep working, so editors can load content behind the holding page.
# Unset or anything else = the real site. Set this in Vercel too, not just here.
COMING_SOON=false

# ---- Security -----------------------------------------------------------
# CSP is always enforced in next.config.ts. unsafe-eval is development-only.
# Direct destination for Schedule a Call and Book a 30-Min. Call.
# Keep this aligned with Site Settings > Calendly URL.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/fekra-egy-info/30min
# Cloudflare Turnstile: required for public form submissions. Never use test
# keys on a public deployment. Register the production and preview hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated allowed hostnames; defaults to the request hostname.
TURNSTILE_HOSTNAMES=

# ---- Blog auto-translation (OpenAI) -------------------------------------
# Powers the "Translate to all languages" button on blog articles.
OPENAI_API_KEY=
# Optional: override the model (default gpt-5-mini).
OPENAI_MODEL=
